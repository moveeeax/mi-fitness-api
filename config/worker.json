{
  "logging": {
    "name": "mi_fitness_api_worker",
    "file": "logs/worker.log",
    "level": "info",
    "format": "${LOG_FORMAT:-text}"
  },
  "observability": {
    "metrics_address": "0.0.0.0:9090",
    "service_name": "mi_fitness_api_worker_service"
  },
  "database": {
    "primary": "postgresql://${DATABASE_USER:-postgres}:${DATABASE_PASSWORD:-postgres}@${DATABASE_HOST:-localhost}:${DATABASE_PORT:-5432}/${DATABASE_NAME:-appdb}",
    "replicas": [],
    "pool_size": 10
  },
  "cache": {
    "use_sentinel": false,
    "url": "tcp://${REDIS_HOST:-127.0.0.1}:${REDIS_PORT:-6379}",
    "password": "${REDIS_PASSWORD:-}",
    "db": "${REDIS_DB:-0}",
    "pool_size": 10,
    "sentinel": {
      "password": "${REDIS_SENTINEL_PASSWORD:-}",
      "master_name": "mymaster",
      "nodes": [
        {
          "host": "localhost",
          "port": 26379
        },
        {
          "host": "localhost",
          "port": 26380
        },
        {
          "host": "localhost",
          "port": 26381
        }
      ]
    }
  },
  "jobs": {
    "enabled": true,
    "result_ttl": 86400,
    "max_retries": 3
  },
  "worker": {
    "id": "worker-1",
    "types": [
      "default",
      "webhook.deliver"
    ],
    "concurrency": 2,
    "health_port": 9091,
    "brpop_timeout": 5
  }
}

{
  "app": {
    "name": "${APP_NAME:-App}",
    "base_url": "${APP_BASE_URL:-http://localhost:8080}",
    "env": "${APP_ENV:-development}"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "threads": 4,
    "max_body_bytes": 10485760,
    "ssl": {
      "enabled": false,
      "cert": "${SSL_CERT_FILE:-}",
      "key": "${SSL_KEY_FILE:-}"
    }
  },
  "shutdown": {
    "pre_stop_delay_sec": 5
  },
  "logging": {
    "name": "mi_fitness_api",
    "file": "logs/app.log",
    "level": "info",
    "format": "${LOG_FORMAT:-text}"
  },
  "observability": {
    "metrics_address": "0.0.0.0:9090",
    "service_name": "mi_fitness_api_service",
    "otlp_endpoint": "${OTLP_ENDPOINT:-}",
    "trace_stdout": "${TRACE_STDOUT:-false}"
  },
  "database": {
    "primary": "postgresql://${DATABASE_USER:-postgres}:${DATABASE_PASSWORD}@${DATABASE_HOST:-localhost}:${DATABASE_PORT:-5432}/${DATABASE_NAME:-appdb}",
    "host": "${DATABASE_HOST:-localhost}",
    "port": "${DATABASE_PORT:-5432}",
    "user": "${DATABASE_USER:-app}",
    "name": "${DATABASE_NAME:-app}",
    "password": "${DATABASE_PASSWORD:-}",
    "replicas": [],
    "pool_size": 10,
    "acquire_timeout_ms": 5000,
    "statement_timeout_ms": 30000,
    "pool_metric_refresh_sec": "${DB_POOL_METRIC_REFRESH_SEC:-10}",
    "replica_lag_metric_refresh_sec": "${DB_REPLICA_LAG_METRIC_REFRESH_SEC:-15}",
    "retry": {
      "max_attempts": "${DB_RETRY_MAX_ATTEMPTS:-2}",
      "base_delay_ms": "${DB_RETRY_BASE_DELAY_MS:-20}",
      "max_delay_ms": "${DB_RETRY_MAX_DELAY_MS:-200}",
      "jitter": "${DB_RETRY_JITTER:-true}"
    },
    "migrations_enabled": true,
    "migrations_dir": "migrations"
  },
  "cache": {
    "use_sentinel": false,
    "url": "tcp://${REDIS_HOST:-127.0.0.1}:${REDIS_PORT:-6379}",
    "password": "${REDIS_PASSWORD:-}",
    "db": "${REDIS_DB:-0}",
    "pool_size": 10,
    "socket_timeout_ms": "${REDIS_SOCKET_TIMEOUT_MS:-500}",
    "pool_wait_timeout_ms": "${REDIS_POOL_WAIT_TIMEOUT_MS:-500}",
    "sentinel": {
      "password": "${REDIS_SENTINEL_PASSWORD:-}",
      "master_name": "mymaster",
      "nodes": [
        {
          "host": "localhost",
          "port": 26379
        },
        {
          "host": "localhost",
          "port": 26380
        },
        {
          "host": "localhost",
          "port": 26381
        }
      ]
    }
  },
  "mail": {
    "enabled": "${MAIL_ENABLED:-false}",
    "via_jobs": "${MAIL_VIA_JOBS:-true}",
    "smtp_host": "${MAIL_SMTP_HOST:-mailpit}",
    "smtp_port": "${MAIL_SMTP_PORT:-1025}",
    "smtp_username": "${MAIL_SMTP_USERNAME:-}",
    "smtp_password": "${MAIL_SMTP_PASSWORD:-}",
    "smtp_use_tls": "${MAIL_SMTP_USE_TLS:-false}",
    "from": "${MAIL_FROM:-noreply@example.com}",
    "from_name": "${MAIL_FROM_NAME:-App}",
    "subject_prefix": "${MAIL_SUBJECT_PREFIX:-[App] }",
    "templates_dir": "${MAIL_TEMPLATES_DIR:-templates/email}",
    "timeout_sec": 30
  },
  "api": {
    "public_paths": "/,/healthz,/ready,/health,/metrics,/api/v1/docs,/api/v1/openapi.yaml,/api/v1/auth/login,/api/v1/auth/register,/api/v1/auth/refresh,/api/v1/account/confirm/*,/api/v1/account/reset-password-request,/api/v1/account/reset-password/*,/api/v1/account/change-email/*,/api/v1/account/join-from-invite/*",
    "public_paths_extra": "${API_PUBLIC_PATHS_EXTRA:-}"
  },
  "cors": {
    "allowed_origins": "${CORS_ALLOWED_ORIGINS:-}"
  },
  "docs": {
    "enabled": "${DOCS_ENABLED:-false}",
    "openapi_path": "docs/openapi.yaml"
  },
  "security": {
    "hsts": "${SECURITY_HSTS:-false}",
    "hsts_max_age": 31536000,
    "csrf": {
      "enabled": "${SECURITY_CSRF_ENABLED:-false}",
      "cookie_name": "csrf-token",
      "header_name": "X-CSRF-Token"
    }
  },
  "auth": {
    "mode": "${AUTH_MODE:-none}",
    "bearer_token": "${AUTH_BEARER_TOKEN:-}",
    "cookies": {
      "enabled": false,
      "access_name": "__Host-access",
      "refresh_name": "__Host-refresh",
      "access_ttl_sec": 900,
      "refresh_ttl_sec": 604800,
      "secure": true,
      "samesite": "Lax",
      "refresh_revocation_prefix": "auth:refresh:"
    },
    "jwt": {
      "secret": "${JWT_SECRET:-}",
      "issuer": "${JWT_ISSUER:-}",
      "audience": "${JWT_AUDIENCE:-}",
      "leeway_sec": 30,
      "roles_claim": "roles",
      "scopes_claim": "scope",
      "secrets": {}
    }
  },
  "idempotency": {
    "enabled": false,
    "ttl_sec": 86400,
    "lock_ttl_sec": 30,
    "max_body_kb": 1024,
    "max_response_kb": 256
  },
  "rate_limit": {
    "enabled": false,
    "requests": 60,
    "window_sec": 60,
    "protected_requests": 10,
    "protected_window_sec": 60,
    "scope": "ip_or_user",
    "trust_proxy": false,
    "trusted_proxy_count": "${RATE_LIMIT_TRUSTED_PROXY_COUNT:-1}",
    "fail_open": true,
    "whitelist": ""
  },
  "jobs": {
    "enabled": false,
    "result_ttl": 86400,
    "max_retries": 3,
    "retry_backoff_base_ms": "${JOBS_RETRY_BACKOFF_BASE_MS:-0}",
    "retry_backoff_max_ms": "${JOBS_RETRY_BACKOFF_MAX_MS:-60000}",
    "visibility_timeout_sec": "${JOBS_VISIBILITY_TIMEOUT_SEC:-0}",
    "dlq_metric_refresh_sec": "${JOBS_DLQ_METRIC_REFRESH_SEC:-10}",
    "queue_metric_refresh_sec": "${JOBS_QUEUE_METRIC_REFRESH_SEC:-10}"
  },
  "outbox": {
    "drain_interval_sec": "${OUTBOX_DRAIN_INTERVAL_SEC:-0}"
  },
  "worker": {
    "id": "worker-1",
    "types": ["default"],
    "strict_types": "${WORKER_STRICT_TYPES:-false}",
    "concurrency": 2,
    "health_port": 9091,
    "brpop_timeout": 5
  }
  ,"xiaomi": {
    "token_key": "${MI_FITNESS_TOKEN_KEY:-}",
    "user_id": "${MI_FITNESS_USER_ID:-}",
    "pass_token": "${MI_FITNESS_PASS_TOKEN:-}",
    "region": "${MI_FITNESS_REGION:-cn}",
    "reseed": "${MI_FITNESS_RESEED:-false}",
    "sync_chunk_days": "${MI_FITNESS_CHUNK_DAYS:-7}",
    "sync_type_timeout_seconds": "${MI_FITNESS_SYNC_TYPE_TIMEOUT:-180}",
    "http_timeout_seconds": "${MI_FITNESS_HTTP_TIMEOUT:-20}"
  }
}
